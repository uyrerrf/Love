# ============================================================================
# FasonRat Production Environment
# Copy this file to .env, fill in the required values, and never commit it.
# Generate secrets with: openssl rand -base64 48
# ============================================================================

# Application
NODE_ENV=production

# Authentication (Required)
# Secret key (minimum 32 characters)
BETTER_AUTH_SECRET=

# Public application URL (https://example.com, no trailing slash)
BETTER_AUTH_URL=

# Trusted CORS origins (comma-separated, optional)
BETTER_AUTH_TRUSTED_ORIGINS=

# Default Admin (optional, first boot only)
# Skips setup wizard when configured.
# ADMIN_PASSWORD=
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@example.com

# Reverse Proxy
# Set to 1/true when using nginx, Caddy, or Cloudflare.
FASON_TRUST_PROXY=1

# Logging
# Levels: fatal, error, warn, info, debug, trace
LOG_LEVEL=info